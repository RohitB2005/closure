# Copy to .env and fill in. At least one key is required.

# Primary provider: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional fallback: Gemini API directly (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# OPENROUTER_MODELS=google/gemini-2.5-flash          # writer, intake (comma-separated = fallback order)
# OPENROUTER_SMART_MODELS=google/gemini-3.8-flash    # critic
# GEMINI_MODELS=gemini-flash-latest
# LLM_ORDER=openrouter,gemini
